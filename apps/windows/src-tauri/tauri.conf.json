{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Patch Manager",
  "version": "0.1.0",
  "identifier": "io.github.steampatch.manager",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Steam 补丁管理", "width": 1180, "height": 760, "minWidth": 850, "minHeight": 560 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": ["nsis"], "externalBin": ["binaries/steam-patch", "binaries/sf-worker"], "resources": ["resources/catalog.json", "resources/signed-catalog.json", "resources/trust-keys.json", "resources/LICENSE", "resources/licenses/sfextract-MIT.txt"] }
}
